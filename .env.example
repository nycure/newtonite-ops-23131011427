# Environment Configuration for Newtonite Ops
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=super-secret-newtonite-challenge-key-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# For local zero-setup dev & Pytest (uses SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./newtonite_ops.db
# For Docker Compose / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://newtonite:password@postgres:5432/newtonite_ops

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_RETRIES=3
